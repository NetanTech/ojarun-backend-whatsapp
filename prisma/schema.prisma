generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Admin {
  id              String        @id @default(uuid()) @db.Uuid
  email           String        @unique
  passwordHash    String        @map("password_hash")
  name            String?
  phone           String?
  role            AdminRole     @default(admin)
  status          AdminStatus   @default(active)
  avatarUrl       String?       @map("avatar_url")
  lastActiveAt    DateTime?     @map("last_active_at") @db.Timestamptz(6)
  inviteTokenHash String?       @map("invite_token_hash")
  inviteMessage   String?       @map("invite_message")
  invitedById     String?       @map("invited_by_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  conversations   conversations[]

  @@index([status])
  @@map("admins")
}

model PasswordResetOtp {
  id        String    @id @default(uuid()) @db.Uuid
  email     String
  codeHash  String    @map("code_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([email])
  @@map("password_reset_otps")
}

model Customer {
  id                      String         @id @default(uuid()) @db.Uuid
  whatsappNumber          String         @unique @map("whatsapp_number")
  name                    String?
  createdAt               DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  conversations           conversations?
  messages                Message[]
  orders                  Order[]
  chatSessions            ChatSession[]
  contextSummary          String?        @map("context_summary")
  contextSummaryUpdatedAt DateTime?      @map("context_summary_updated_at") @db.Timestamptz(6)

  @@map("customers")
}

model Product {
  id           String      @id @default(uuid()) @db.Uuid
  name         String
  unit         String
  currentPrice Decimal     @map("current_price") @db.Decimal(12, 2)
  isAvailable  Boolean     @default(true) @map("is_available")
  category     String?
  description  String?
  imageUrl     String?     @map("image_url")
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  orderItems   OrderItem[]

  @@map("products")
}

model Order {
  id                String        @id @default(uuid()) @db.Uuid
  customerId        String        @map("customer_id") @db.Uuid
  channel           Channel       @default(whatsapp)
  status            OrderStatus   @default(pending)
  paymentStatus     PaymentStatus @default(unpaid) @map("payment_status")
  total             Decimal       @default(0) @db.Decimal(12, 2)
  customerNotes     String?       @map("customer_notes")
  paystackReference String?       @unique @map("paystack_reference")
  paymentUrl        String?       @map("payment_url")
  paidAt            DateTime?     @map("paid_at") @db.Timestamptz(6)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  items             OrderItem[]
  customer          Customer      @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@index([status])
  @@index([paymentStatus])
  @@map("orders")
}

model OrderItem {
  id                  String   @id @default(uuid()) @db.Uuid
  orderId             String   @map("order_id") @db.Uuid
  productId           String?  @map("product_id") @db.Uuid
  productNameSnapshot String   @map("product_name_snapshot")
  unitSnapshot        String   @map("unit_snapshot")
  unitPriceSnapshot   Decimal  @map("unit_price_snapshot") @db.Decimal(12, 2)
  quantity            Decimal  @db.Decimal(12, 3)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  order               Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product             Product? @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

model Message {
  id                String           @id @default(uuid()) @db.Uuid
  customerId        String           @map("customer_id") @db.Uuid
  sessionId         String?          @map("session_id") @db.Uuid
  whatsappMessageId String?          @unique @map("whatsapp_message_id")
  direction         MessageDirection
  body              String?
  raw               Json
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  customer          Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  session           ChatSession?     @relation(fields: [sessionId], references: [id])

  @@index([customerId, createdAt])
  @@index([sessionId, createdAt])
  @@map("messages")
}

/// Bot/human handoff toggle per customer. When mode=human, WhatsApp auto-replies pause.
model conversations {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customer_id       String           @unique @db.Uuid
  mode              ConversationMode @default(bot)
  state             Json             @default("{}")
  assigned_admin_id String?          @db.Uuid
  created_at        DateTime         @default(now()) @db.Timestamptz(6)
  updated_at        DateTime         @default(now()) @db.Timestamptz(6)
  customers         Customer         @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  assigned_admin    Admin?           @relation(fields: [assigned_admin_id], references: [id], onDelete: SetNull)

  @@index([customer_id])
  @@index([assigned_admin_id])
  @@index([mode])
}

/// Per-session message grouping for AI context + a rolling customer summary.
/// Distinct from `conversations` above, which is a bot/human handoff toggle.
model ChatSession {
  id                   String            @id @default(uuid()) @db.Uuid
  customerId           String            @map("customer_id") @db.Uuid
  customer             Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  status               ChatSessionStatus @default(active)
  startedAt            DateTime          @default(now()) @map("started_at") @db.Timestamptz(6)
  lastActivityAt       DateTime          @default(now()) @map("last_activity_at") @db.Timestamptz(6)
  closedAt             DateTime?         @map("closed_at") @db.Timestamptz(6)
  summary              String?
   pendingItems          Json?     
  draftItems           Json?             @map("draft_items")
  draftDeliveryAddress String?           @map("draft_delivery_address")
    draftDeliveryAddressMeta Json?   
  messages             Message[]

  @@index([customerId, status])
  @@index([lastActivityAt])
  @@map("chat_sessions")
}

model BotResponse {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key       String   @unique
  body      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("bot_responses")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model PendingOrder {
  id         String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  phone      String    @unique
  startedAt  DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  remindedAt DateTime? @map("reminded_at") @db.Timestamptz(6)
  completed  Boolean   @default(false)

  @@map("pending_orders")
}

enum Channel {
  whatsapp
  web
  app
}

enum OrderStatus {
  pending
  awaiting_payment
  confirmed
  shopping
  purchased
  dispatched
  delivered
  cancelled
}

enum PaymentStatus {
  unpaid
  pending
  paid
  failed
}

enum MessageDirection {
  inbound
  outbound
}

enum ConversationMode {
  bot
  human
}

enum AdminRole {
  superadmin
  admin
  agent
  customer_care
  customer_support
}

enum AdminStatus {
  active
  inactive
  invited
}

enum ChatSessionStatus {
  active
  closed
}