# Copy this file to .env and fill in real values.
# See README.md for how to get the Supabase and WhatsApp values.

NODE_ENV=development
PORT=4000

# --- Database (Supabase Postgres) ---
DATABASE_URL=
DIRECT_URL=

# --- WhatsApp Cloud API (required — see README "Connecting Meta") ---
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0

# --- AI (Groq or OpenAI-compatible) ---
AI_PROVIDER=groq
AI_API_KEY=
AI_MODEL=llama3-8b-8192

# --- Email (ZeptoMail, used for admin password reset + order notifications) ---
EMAIL_FROM=
EMAIL_FROM_NAME=OjaRun
EMAIL_ADMIN_TO=
ZEPTOMAIL_API_KEY=

# --- SMS (Termii — used for customer signup/login OTP) ---
# Leave blank in local dev: the OTP code is logged to the server console
# instead of being sent, so you can test the full signup flow for free.
TERMII_API_KEY=
SMS_SENDER_ID=Ojarun

# --- Auth ---
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_RESET_EXPIRES_IN=15m

# --- CORS ---
# Must list every frontend origin allowed to call this API, comma-separated.
# http://localhost:3000 = ojarun-web (customer site)
# http://localhost:3001 = admin dashboard, if/when it exists
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

WEB_APP_URL=http://localhost:3000

# --- Paystack ---
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# --- Cloudinary (product image uploads) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
